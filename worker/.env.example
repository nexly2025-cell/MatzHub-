# ============================================================================
# MatzHub WhatsApp worker — persistent Node process.
#
# Runs `whatsapp-worker.mjs` continuously and holds an active Baileys socket.
# This CANNOT run on Vercel or Cloudflare Workers — those runtimes tear the
# process down between requests, destroying the WhatsApp session. Deploy this
# to any Docker/persistent-Node host (see DEPLOYMENT.md → "WhatsApp worker").
#
# The session is persisted to Supabase Storage (bucket: wa-sessions), so
# redeploys DO NOT require re-scanning the QR.
# ============================================================================

# Where to POST ingested messages. Point at your production Vercel URL.
MATZHUB_API_URL=https://matzhub.com

# Must match INGEST_TOKEN on the platform side. /api/ingest returns 401 otherwise.
INGEST_TOKEN=

# Only required when the GitHub repository is PRIVATE. Fine-grained PAT with
# read-only "Contents" on nexly2025-cell/MatzHub-. Used solely by
# deploy-worker.sh to pull; never written to git config or logs.
GITHUB_TOKEN=

# Required on the worker to authorize sub-daily scheduled cron triggers on Vercel.
CRON_SECRET=

# Local path inside the container. In Docker this is mounted at /data/.wa-session
# so the pairing survives a container restart. Supabase Storage is still the
# source of truth across redeploys — see worker/session-store.mjs.
WA_SESSION_DIR=/data/.wa-session

# Health + control server port. Docker exposes 8081; keep them aligned.
WA_WORKER_PORT=8081

# Bearer token that guards /qr, /restart, /relink, /backfill, /send.
# MUST match WA_WORKER_TOKEN on the platform side. Without this, Telegram
# admin commands that talk to the worker are refused (fail-closed).
WA_WORKER_TOKEN=

# Supabase — image hosting AND persistent session storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products
SUPABASE_VIDEO_BUCKET=product-media

# Exact supplier group JIDs, comma-separated. This can only narrow the checked-in
# closed allow-list; it never admits a new group.
WA_GROUP_IDS=120363337186642655@g.us,120363136590856235@g.us,120363084957889605@g.us,120363086598656877@g.us,120363169458002169@g.us,120363088334492923@g.us,120363089280152472@g.us,120363103975055296@g.us,120363027163825724@g.us

# Optional human-readable filter for development or a stricter subset.
# WA_GROUPS=Watches,Footwear

# Optional: pairing-code linking instead of QR (some environments block QR).
# WA_PAIRING_NUMBER=91XXXXXXXXXX
