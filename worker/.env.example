# MatzHub WhatsApp worker — persistent Node process.
MATZHUB_API_URL=http://localhost:3000
INGEST_TOKEN=                 # must match the platform value
WA_SESSION_DIR=./.wa-session
WA_WORKER_PORT=8081
WA_WORKER_TOKEN=              # guards /qr /restart /relink /backfill /send

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products
SUPABASE_VIDEO_BUCKET=product-media

# WA_GROUPS=Watches,Footwear   # optional subject filter; empty watches all
# WA_PAIRING_NUMBER=91XXXXXXXXXX  # pairing code instead of QR
# WA_RUN_MS=900000                # scheduled mode: exit after N ms
