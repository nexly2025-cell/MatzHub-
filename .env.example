<<<<<<< HEAD
# ── App: required in every environment ─────────────────────────────────────
DATABASE_URL=
# Managed Postgres behind a pooler (Supabase / Neon): point DATABASE_URL at
# the TRANSACTION-mode pooler (:6543) and DIRECT_DATABASE_URL at the
# SESSION-mode pooler (:5432). drizzle-kit needs session mode for DDL; the app
# must not hold session-mode connections or the build dies with
# `EMAXCONNSESSION: max clients reached in session mode`.
DIRECT_DATABASE_URL=
# Connections per process. Keep low — every serverless instance opens its own.
DATABASE_POOL_MAX=4

NEXT_PUBLIC_SITE_URL=https://matzhub.com
NEXT_PUBLIC_CUSTOMER_WHATSAPP=9187412133


# ── Auth (admin + service-to-service) ──────────────────────────────────────
# /admin is effectively unprotected without these. Generate with
# `openssl rand -hex 32`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Bearer token the worker uses when calling /api/ingest.
INGEST_TOKEN=
# Bearer token Vercel Cron (and any manual /run) uses when hitting /api/cron/*.
CRON_SECRET=


# ── Telegram operator control plane ────────────────────────────────────────
# Two bots, two roles. The dev bot receives diagnostics only; the admin bot
# runs the business. Role is decided by the webhook URL, not the sender.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Proves inbound calls are from Telegram (X-Telegram-Bot-Api-Secret-Token
# header). Generate with `openssl rand -hex 24`.
TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_DEV_BOT_TOKEN=
TELEGRAM_DEV_CHAT_ID=          # comma-separated for multiple developers
TELEGRAM_DEV_WEBHOOK_SECRET=   # falls back to TELEGRAM_WEBHOOK_SECRET


# ── WhatsApp worker (persistent Node process; NOT Vercel/serverless) ───────
# URL of the deployed worker (see DEPLOYMENT.md → "WhatsApp worker").
# Leave empty to keep the platform running without WhatsApp ingestion — the
# storefront works, only auto-ingestion is idle.
WA_WORKER_URL=                 # e.g. https://matzhub-worker.fly.dev
WA_WORKER_TOKEN=               # required for /qr /restart /relink /backfill

# Read-only ingestion SIM. Optional. When set, only groups whose JID ends in
# the last 10 digits of this number are accepted at /api/ingest. Leave empty
# to allow every group the paired account has joined.
SUPPLIER_INGESTION_NUMBER=


# ── Supabase (database is above; this section is Storage + session state) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products              # images
SUPABASE_VIDEO_BUCKET=product-media   # videos
# The worker also uses a private "wa-sessions" bucket for Baileys credentials.
# It is created automatically by `worker/ensure-supabase-buckets.mjs`.


# ── Cashfree subscription (operator billing; never visible to customers) ───
# Without CASHFREE_SECRET_KEY the webhook rejects every caller and automatic
# uploads eventually pause. Existing products keep serving regardless.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox                  # sandbox | production
SUBSCRIPTION_PRICE_INR=2500
# ISO date of the most recent payment. Expiry = anchor + 30 days.
# Superseded automatically by any Cashfree webhook that arrives.
SUBSCRIPTION_LAST_PAYMENT=
# ISO date. Billing begins on the 1st of next month unless overridden.
SUBSCRIPTION_BILLING_STARTS=


# ── Optional ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=                # better product copy; rules engine used if absent
OPENAI_MODEL=gpt-4o-mini
LOG_LEVEL=info
UPTIME_WEBHOOK_URL=            # escalation channel when Telegram itself is down

# Reseller OTP delivery. Presence of either flips /api/reseller-auth into OTP
# mode. Absent → magic-link fallback for development.
TWILIO_AUTH_TOKEN=
TEXT_LOCAL_KEY=


# ── Provisioning ONLY (never set at app runtime) ───────────────────────────
# Consumed by `npm run provision` (scripts/provision.mjs). Export them in your
# shell before running that script; do NOT commit them or set them on Vercel.
=======
# ── REQUIRED — core launch ─────────────────────────────────────────────────
# App database. Point at the TRANSACTION-mode pooler (Supabase :6543 / Neon
# pooled). Serverless instances must not hold session-mode connections.
DATABASE_URL=
# Same cluster, SESSION-mode pooler (:5432). Used ONLY by drizzle-kit for DDL;
# the app never reads it.
DIRECT_DATABASE_URL=

# Canonical public host and customer support number (wa.me).
NEXT_PUBLIC_SITE_URL=https://matzhub.com
NEXT_PUBLIC_CUSTOMER_WHATSAPP=

# /admin gate + session-signing secret. Generate: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Service-to-service tokens. Generate: openssl rand -hex 32
INGEST_TOKEN=     # bearer token the worker sends to /api/ingest
CRON_SECRET=      # bearer token for /api/cron/<job>

# Telegram admin control plane.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Proves inbound webhook calls are from Telegram. Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# Supabase: API base + secret key (sb_secret_... or legacy service_role JWT)
# + storage buckets. Found in Supabase Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products

# WhatsApp worker (persistent Node process, see DEPLOYMENT.md → Deploy to EC2).
# Leave empty to run the storefront without WhatsApp ingestion.
WA_WORKER_URL=
WA_WORKER_TOKEN=


# ── OPTIONAL — Cashfree subscription billing only ──────────────────────────
# Operator billing: gates whether newly ingested products publish
# automatically. Without these keys the webhook rejects callers and automatic
# uploads pause when the subscription anchor expires; the storefront and all
# existing products keep serving regardless.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox                    # sandbox | production
SUBSCRIPTION_PRICE_INR=2500
SUBSCRIPTION_LAST_PAYMENT=              # ISO date; expiry = anchor + 30 days
SUBSCRIPTION_BILLING_STARTS=            # ISO date; billing starts 1st of month


# ── FEATURE-GATED — NOT required for launch ────────────────────────────────
# Each feature works without its keys (fallback path is tested). Set them only
# when you actually use the feature.

# LLM product enrichment. Absent → rules-engine enrichment (tested fallback).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Reseller OTP delivery. Absent → dev bootstrap path without OTP.
TWILIO_AUTH_TOKEN=
TEXT_LOCAL_KEY=

# External escalation webhook when Telegram itself is down. Absent → no alert.
UPTIME_WEBHOOK_URL=

# Verbosity of structured logs. info | debug.
LOG_LEVEL=info

# Developer diagnostics bot. Absent → admin bot still works, dev commands idle.
TELEGRAM_DEV_BOT_TOKEN=
TELEGRAM_DEV_CHAT_ID=
TELEGRAM_DEV_WEBHOOK_SECRET=

# Worker-side supplier isolation (last 10 digits of the ingestion SIM).
# Absent → every group the paired account has joined is ingested.
SUPPLIER_INGESTION_NUMBER=

# Video bucket. Absent → defaults to "product-media".
SUPABASE_VIDEO_BUCKET=

# Connection pool sizing + SSL override. Absent → max 4, SSL auto.
DATABASE_POOL_MAX=4
DATABASE_SSL=


# ── WORKER ONLY (worker/.env.example is the canonical copy) ────────────────
# WA_SESSION_DIR, WA_WORKER_PORT, WA_GROUPS, WA_PAIRING_NUMBER, WA_BACKFILL


# ── PROVISIONING ONLY (never set at app runtime) ───────────────────────────
# Consumed by `npm run provision`. Export them in your shell; never commit.
