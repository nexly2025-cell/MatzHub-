# ============================================================================
# MatzHub — canonical environment reference.
#
# Every variable listed here is read by the application, cron jobs, or the
# WhatsApp worker. Verify with:
#   grep -rhoE "process\.env\.[A-Z_][A-Z_0-9]*" src/ worker/*.mjs scripts/ \
#     | sort -u
#
# Split responsibility:
#   Vercel  → serves Next.js, API routes and cron jobs.
#   Worker  → persistent Node process (Fly.io / Render / any Docker host)
#             running worker/whatsapp-worker.mjs.
#   Both    → talk to Supabase for the database and image + session storage.
#
# NEVER commit a filled-in copy of this file. .gitignore blocks .env* variants.
# ============================================================================


# ── App: required in every environment ─────────────────────────────────────
DATABASE_URL=
# Managed Postgres behind a pooler (Supabase / Neon): point DATABASE_URL at
# the TRANSACTION-mode pooler (:6543) and DIRECT_DATABASE_URL at the
# SESSION-mode pooler (:5432). drizzle-kit needs session mode for DDL; the app
# must not hold session-mode connections or the build dies with
# `EMAXCONNSESSION: max clients reached in session mode`.
DIRECT_DATABASE_URL=
# Connections per process. Keep low — every serverless instance opens its own.
DATABASE_POOL_MAX=4

NEXT_PUBLIC_SITE_URL=https://matzhub.com
NEXT_PUBLIC_CUSTOMER_WHATSAPP=9187412133


# ── Auth (admin + service-to-service) ──────────────────────────────────────
# /admin is effectively unprotected without these. Generate with
# `openssl rand -hex 32`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Bearer token the worker uses when calling /api/ingest.
INGEST_TOKEN=
# Bearer token Vercel Cron (and any manual /run) uses when hitting /api/cron/*.
CRON_SECRET=


# ── Telegram operator control plane ────────────────────────────────────────
# Two bots, two roles. The dev bot receives diagnostics only; the admin bot
# runs the business. Role is decided by the webhook URL, not the sender.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Proves inbound calls are from Telegram (X-Telegram-Bot-Api-Secret-Token
# header). Generate with `openssl rand -hex 24`.
TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_DEV_BOT_TOKEN=
TELEGRAM_DEV_CHAT_ID=          # comma-separated for multiple developers
TELEGRAM_DEV_WEBHOOK_SECRET=   # falls back to TELEGRAM_WEBHOOK_SECRET


# ── WhatsApp worker (persistent Node process; NOT Vercel/serverless) ───────
# URL of the deployed worker (see DEPLOYMENT.md → "WhatsApp worker").
# Leave empty to keep the platform running without WhatsApp ingestion — the
# storefront works, only auto-ingestion is idle.
WA_WORKER_URL=                 # e.g. https://matzhub-worker.fly.dev
WA_WORKER_TOKEN=               # required for /qr /restart /relink /backfill

# Comma-separated supplier WhatsApp group JIDs allowed to post to /api/ingest.
# Required in production. Obtain these from the authenticated Telegram /channels view.
WA_GROUP_IDS=


# ── Supabase (database is above; this section is Storage + session state) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products              # images
SUPABASE_VIDEO_BUCKET=product-media   # videos
# The worker also uses a private "wa-sessions" bucket for Baileys credentials.
# It is created automatically by `worker/ensure-supabase-buckets.mjs`.


# ── Cashfree subscription (operator billing; never visible to customers) ───
# Without CASHFREE_SECRET_KEY the webhook rejects every caller and automatic
# uploads eventually pause. Existing products keep serving regardless.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox                  # sandbox | production
SUBSCRIPTION_PRICE_INR=2500
# ISO date of the most recent payment. Expiry = anchor + 30 days.
# Superseded automatically by any Cashfree webhook that arrives.
SUBSCRIPTION_LAST_PAYMENT=
# ISO date. Billing begins on the 1st of next month unless overridden.
SUBSCRIPTION_BILLING_STARTS=


# ── Optional ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=                # better product copy; rules engine used if absent
OPENAI_MODEL=gpt-4o-mini
LOG_LEVEL=info
UPTIME_WEBHOOK_URL=            # escalation channel when Telegram itself is down

# Reseller OTP delivery. Presence of either flips /api/reseller-auth into OTP
# mode. Absent → magic-link fallback for development.
TWILIO_AUTH_TOKEN=
TEXT_LOCAL_KEY=


# ── Provisioning ONLY (never set at app runtime) ───────────────────────────
# Consumed by `npm run provision` (scripts/provision.mjs). Export them in your
# shell before running that script; do NOT commit them or set them on Vercel.
#   CLOUDFLARE_API_TOKEN=   CLOUDFLARE_ZONE_ID=
#   VERCEL_API_TOKEN=       VERCEL_PROJECT_ID=   VERCEL_TEAM_ID=
#   APEX_DOMAIN=matzhub.com
