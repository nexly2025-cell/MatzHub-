# MatzHub — production environment.
# Every variable here is read by code. Verify with:
#   grep -rhoE "process\.env\.[A-Z_]+" src/ worker/*.mjs | sort -u

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=
# Managed Postgres behind a pooler (Supabase/Neon): point DATABASE_URL at the
# TRANSACTION pooler (:6543) and this at the SESSION pooler (:5432). drizzle-kit
# needs session mode for DDL; the app must not hold session-mode connections or
# the build dies with EMAXCONNSESSION: max clients reached in session mode.
DIRECT_DATABASE_URL=
# Connections per process. Keep low: every serverless instance opens its own.
DATABASE_POOL_MAX=4
NEXT_PUBLIC_SITE_URL=https://matzhub.com
NEXT_PUBLIC_CUSTOMER_WHATSAPP=9187412133

# /admin is unprotected without these. openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
INGEST_TOKEN=            # bearer token the worker sends to /api/ingest
CRON_SECRET=             # bearer token for /api/cron/<job>

# ── Telegram: two bots, two roles ───────────────────────────────────────────
# Admin runs business operations. Dev receives diagnostics only.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET= # proves inbound calls are Telegram. openssl rand -hex 24
# Developer bot. Separate token, separate webhook URL, separate allowlist.
# Without all three the developer bot cannot respond at all.
TELEGRAM_DEV_BOT_TOKEN=
TELEGRAM_DEV_CHAT_ID=          # comma-separated for several developers
TELEGRAM_DEV_WEBHOOK_SECRET=   # falls back to TELEGRAM_WEBHOOK_SECRET

# ── WhatsApp worker (persistent Node process) ───────────────────────────────
WA_WORKER_URL=           # e.g. https://worker.matzhub.com
WA_WORKER_TOKEN=         # required for /qr, /restart, /relink, /backfill

# ── Storage ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products

# ── Cashfree subscription (operator billing; never visible to customers) ────
# Without CASHFREE_SECRET_KEY the webhook rejects every caller and automatic
# uploads stay paused. Existing products keep serving regardless.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox        # sandbox | production
SUBSCRIPTION_PRICE_INR=2500
# Date of the most recent payment (ISO). Expiry is exactly 30 days later.
# Superseded automatically once a Cashfree webhook is received.
SUBSCRIPTION_LAST_PAYMENT=
# Billing begins on the 1st of next month unless overridden (ISO date).
# Until then uploads run free; the storefront is never affected either way.
SUBSCRIPTION_BILLING_STARTS=

# Read-only ingestion SIM. Optional: unset, any paired account ingests from
# every supplier group it has joined.
SUPPLIER_INGESTION_NUMBER=

# ── Optional ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=              # better product copy; rules engine used if absent
OPENAI_MODEL=gpt-4o-mini
LOG_LEVEL=info
UPTIME_WEBHOOK_URL=          # escalation when Telegram itself is down

# ── Deployment only (never set in the app runtime) ──────────────────────────
# Consumed by `npm run provision` to configure Cloudflare DNS/TLS and the
# Vercel project. Export them in your shell; do not commit them.
#   CLOUDFLARE_API_TOKEN=   CLOUDFLARE_ZONE_ID=
#   VERCEL_API_TOKEN=       VERCEL_PROJECT_ID=   VERCEL_TEAM_ID=
#   APEX_DOMAIN=matzhub.com
