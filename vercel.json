{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "src/app/api/**": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/subscription",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/expire",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/trending",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/cron/watchdog",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/storage-sweep",
      "schedule": "0 4 * * *"
    }
  ]
}
